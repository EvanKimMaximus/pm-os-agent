# Copy to .env and fill in. .env is gitignored, never commit your key.

# No API key needed: Cortex runs on Claude via the Claude Agent SDK and your
# Claude CLI login (run `claude auth login` once).

# Model + bounds. These ARE your M5 deliverable, tune and justify them.
CORTEX_MODEL=haiku            # cheap, fast Claude model; try `sonnet` to compare
CORTEX_CRITIC_MODEL=sonnet    # stronger model for the critic, the last check before a human
CORTEX_DEMO_BAD_DRAFT=        # set to 1 to tamper with the first draft and watch the critic reject it
CORTEX_WITHHOLD=              # grounding probe: e.g. get_activity, makes that source unavailable
CORTEX_FAIL_ONCE=             # recovery eval: e.g. get_activity, first call fails like a 500
# Kill switch: create the file 00-build/CORTEX_KILL to halt every run; delete it to resume.
CORTEX_MAX_ITERATIONS=8       # loop cap: stop + escalate instead of spinning
CORTEX_MAX_REVISIONS=2        # critic<->drafter cap: stop the bounce-forever bomb
CORTEX_COST_CAP_USD=0.20      # hard spend cap per run, enforced outside the model (worst case seen ~$0.10)
CORTEX_DAILY_CAP_USD=5.00     # hard spend cap across all runs per day (ledger in run-output/)
CORTEX_TIMEOUT_S=120          # wall-clock cap per run; a normal run takes ~50s
CORTEX_MAX_QUEUE_ITEMS=10     # commitment cap: max backlog stories queued per run
CORTEX_MAX_STALE_DAYS=14      # stale-data stop: newest activity older than this -> escalate
CORTEX_TODAY=                 # optional YYYY-MM-DD override, only to demo the stale exit
